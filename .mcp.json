{
  "mcpServers": {
    "Roblox_Studio": {
      "command": "cmd.exe",
      "args": ["/c", "%LOCALAPPDATA%\\Roblox\\mcp.bat"]
    },
    "blender": {
      "command": "cmd.exe",
      "args": ["/c", "uvx", "blender-mcp"],
      "env": { "DISABLE_TELEMETRY": "true" }
    },
    "roblox_docs": {
      "command": "cmd.exe",
      "args": ["/c", "uvx", "mcp-roblox-docs"]
    }
  }
}
